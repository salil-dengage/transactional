# ---- Dengage API credentials ----
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored so your secrets never leave this machine / server.

DENGAGE_BASE_URL=https://api.dengage.com/rest
DENGAGE_USERKEY=your-dengage-userkey
DENGAGE_PASSWORD=your-dengage-password

# ---- Portal access (what your team types to log into the showcase) ----
PORTAL_PASSWORD=change-me-to-a-strong-shared-password

# Used to sign the portal session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=generate-a-long-random-hex-string

# ---- Demo defaults ----
# Default recipient shown in the transactional email demo.
DEFAULT_DEMO_RECIPIENT=salil.gupta@dengage.com
